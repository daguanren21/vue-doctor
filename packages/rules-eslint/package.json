    "vue-eslint-parser": "10.4.1"
  },
  "peerDependencies": {
    "typescript": ">=4.9.5 <6.1.0"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
