{
  "name": "@daguanren21/vue-doctor-rules-eslint",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
