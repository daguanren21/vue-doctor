{
  "name": "@daguanren21/vue-doctor-rule-pack-eslint",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@daguanren21/vue-doctor-core": "workspace:*",
    "@daguanren21/vue-doctor-rules": "workspace:*",
    "@daguanren21/vue-doctor-rules-eslint": "workspace:*",
    "eslint": "10.12.0"
  },
  "scripts": {
    "build": "node scripts/generate-eslint-metadata.mjs && tsdown src/index.ts --format esm --dts && node scripts/copy-eslint-license.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
