{
  "name": "@daguanren21/vue-doctor-rule-pack-vue",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./rules": {
      "types": "./dist/rules.d.mts",
      "import": "./dist/rules.mjs"
    }
  },
  "dependencies": {
    "@daguanren21/vue-doctor-core": "workspace:*",
    "@daguanren21/vue-doctor-source": "workspace:*",
    "@vue/shared": "3.5.44"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/rules.ts --format esm --dts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
