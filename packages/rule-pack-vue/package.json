{
  "name": "@vue-doctor/rule-pack-vue",
  "version": "0.0.0",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./rules": {
      "types": "./dist/rules.d.mts",
      "import": "./dist/rules.mjs"
    }
  },
  "dependencies": {
    "@vue-doctor/core": "workspace:*",
    "@vue-doctor/source": "workspace:*"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/rules.ts --format esm --dts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
