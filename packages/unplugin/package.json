{
  "name": "@daguanren21/vue-doctor-unplugin",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./options": {
      "types": "./dist/options.d.mts",
      "import": "./dist/options.mjs"
    }
  },
  "peerDependencies": {
    "@rspack/core": ">=1.0.0",
    "vite": ">=5.0.0",
    "webpack": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    },
    "@rspack/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@daguanren21/vue-doctor-core": "workspace:*",
    "@daguanren21/vue-doctor-inspector": "workspace:*",
    "@daguanren21/vue-doctor-inspector-ui": "workspace:*",
    "@daguanren21/vue-doctor-runner": "workspace:*",
    "unplugin": "3.3.0"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/options.ts --format esm --dts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
