{
  "name": "@daguanren21/vue-doctor-runner",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./source-worker": {
      "types": "./dist/source-worker.d.mts",
      "import": "./dist/source-worker.mjs"
    }
  },
  "dependencies": {
    "@daguanren21/vue-doctor-component-library": "workspace:*",
    "@daguanren21/vue-doctor-core": "workspace:*",
    "@daguanren21/vue-doctor-rule-pack-component-library": "workspace:*",
    "@daguanren21/vue-doctor-rule-pack-eslint": "workspace:*",
    "@daguanren21/vue-doctor-rule-pack-vue": "workspace:*",
    "@daguanren21/vue-doctor-source": "workspace:*",
    "p-map": "7.0.6",
    "piscina": "5.3.0",
    "tinyglobby": "0.2.17"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/source-worker.ts --format esm --dts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
