{
  "name": "@vue-doctor/runner",
  "version": "0.0.0",
  "type": "module",
  "files": ["dist"],
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "dependencies": {
    "@vue-doctor/component-library": "workspace:*",
    "@vue-doctor/core": "workspace:*",
    "@vue-doctor/rule-pack-component-library": "workspace:*",
    "@vue-doctor/rule-pack-eslint": "workspace:*",
    "@vue-doctor/rule-pack-vue": "workspace:*",
    "@vue-doctor/source": "workspace:*",
    "p-map": "7.0.6",
    "piscina": "5.3.0",
    "tinyglobby": "0.2.17"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/source-worker.ts --format esm --dts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
