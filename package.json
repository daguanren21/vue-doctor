{
  "name": "vue-doctor-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm -r --sort run build",
    "test": "vitest run",
    "typecheck": "pnpm build && pnpm -r --sort run typecheck",
    "check": "pnpm typecheck && pnpm test && pnpm bench:check",
    "bench": "pnpm build && node bench/doctor-run.bench.mjs",
    "bench:check": "node bench/doctor-run.bench.mjs --check",
    "bench:session": "pnpm build && node bench/analysis-session.bench.mjs",
    "bench:ci": "pnpm build && pnpm bench:check"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "tsdown": "0.22.3",
    "tinybench": "6.1.3",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  }
}
