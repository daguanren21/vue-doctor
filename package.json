{
  "name": "vue-doctor-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.1 <27",
    "pnpm": ">=12.15.0 <13"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "repo:init": "repo init",
    "repo:doctor": "repo doctor",
    "repo:new": "repo new",
    "repo:check": "repo check",
    "release:plan": "repo release plan",
    "release:prepare": "repo release ci --mode prepare",
    "release:guard": "node scripts/check-public-workspace.mjs",
    "release:check": "pnpm release:guard && pnpm check",
    "release:pack": "pnpm release:guard && pnpm --filter @daguanren21/vue-doctor pack --pack-destination .local/npm",
    "release:publish": "repo release ci --mode publish",
    "release:oidc-audit": "repo release ci --mode oidc-audit",
    "build": "pnpm -r --sort run build",
    "test": "vitest run",
    "typecheck": "pnpm build && pnpm -r --sort run typecheck",
    "check": "pnpm typecheck && pnpm test && pnpm bench:check",
    "bench": "pnpm build && node bench/doctor-run.bench.mjs",
    "bench:check": "node bench/doctor-run.bench.mjs --check",
    "bench:session": "pnpm build && node bench/analysis-session.bench.mjs",
    "bench:ci": "pnpm build && pnpm bench:check"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "repoctl": "6.3.0",
    "tinybench": "6.1.3",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vitest": "5.0.5"
  }
}
